## cp .env.example .env, fill in the blanks, then:
##   set -a && source .env && set +a && dbt seed && dbt run

DBT_ALLOW_EXPERIMENTAL_ADAPTERS=true

## target: prod, default (`type: snowflake`) connection — key-pair auth only
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PRIVATE_KEY=
SNOWFLAKE_ROLE=
SNOWFLAKE_WAREHOUSE=
# these should not correspond to the CLD
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=
# Snowflake's CLD that corresponds to MDLS
SNOWFLAKE_CATALOG_DATABASE=
# defaults to 'SEEDS' if unset — override if that name isn't yours to create
SNOWFLAKE_SEED_DATABASE=

## target: prod, `type: lakecompute` connection (opted into per-model via
## +adapter: lakecompute). LAKE_COMPUTE_AUTH_TOKEN is a `dct_...` self-service
## token minted from the MDLS destination's UI (method: token).
LAKE_COMPUTE_BASE_URL=https://api.dbt-compute.staging.fivetran.com/
LAKE_COMPUTE_AUTH_TOKEN=
LAKE_COMPUTE_DATABASE=
LAKE_COMPUTE_SCHEMA=

