## cp .env.example .env, fill in the blanks, then:
##   set -a && source .env && set +a && dbt seed && dbt run

## target: snowflake_demo — key-pair auth only
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PRIVATE_KEY=
SNOWFLAKE_ROLE=
SNOWFLAKE_WAREHOUSE=
# these should not correspond to the CLD
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=
# Snowflake's CLD that corresponds to MDLS
SNOWFLAKE_CATALOG_DATABASE=

## x_alt_target: dbt_compute
DBT_COMPUTE_BASE_URL=https://api.dbt-compute.staging.fivetran.com/
DBT_COMPUTE_AUTH_TOKEN=
DBT_COMPUTE_ORG=
DBT_COMPUTE_DATABASE=
DBT_COMPUTE_SCHEMA=

