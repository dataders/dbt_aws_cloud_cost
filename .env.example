## cp .env.example .env, fill in the blanks, then:
##   set -a && source .env && set +a && dbt seed && dbt run

DBT_ALLOW_EXPERIMENTAL_ADAPTERS=true

## target: prod, default (`type: snowflake`) connection — key-pair auth only
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PRIVATE_KEY=
SNOWFLAKE_ROLE=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=
# defaults to 'SEEDS' if unset — override if that name isn't yours to create
# (used by dbt_project.yml's seeds config, not profiles.yml)
SNOWFLAKE_SEED_DATABASE=

## target: prod, `type: lakecompute` connection (opted into per-model via
## +adapter: lakecompute). LAKE_COMPUTE_AUTH_TOKEN is a `dct_...` self-service
## PAT (method: fivetran), exchanged for a short-lived JWT. No base_url
## needed -- it defaults to Fivetran's production dbt-compute API, which is
## the one that actually works (the staging host rejects the exchanged JWT;
## see README.md "Verified status"). database/schema are the MDLS-side
## namespace and do NOT inherit from the snowflake connection -- omitting
## them makes the debug read-back probe fail (write and read land in
## different implicit namespaces).
LAKE_COMPUTE_AUTH_TOKEN=
LAKE_COMPUTE_DATABASE=
LAKE_COMPUTE_SCHEMA=

