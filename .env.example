## cp .env.example .env, fill in the blanks, then:
##   set -a && source .env && set +a && dbt seed && dbt run

DBT_ALLOW_EXPERIMENTAL_ADAPTERS=true

## target: snowflake_demo — key-pair auth only
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PRIVATE_KEY=
SNOWFLAKE_ROLE=
SNOWFLAKE_WAREHOUSE=
# these should not correspond to the Horizon-catalog database
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=
# the Snowflake database the Alt engine writes Iceberg tables into via Horizon
SNOWFLAKE_CATALOG_DATABASE=
# optional -- catalogs.yml already defaults this to SNOWFLAKE_MANAGED, so you
# won't need to set it unless you want to point at your own external volume
SNOWFLAKE_EXTERNAL_VOLUME=

## x_alt_target: lake_compute
LAKE_COMPUTE_BASE_URL=https://api.dbt-compute.staging.fivetran.com/
LAKE_COMPUTE_AUTH_TOKEN=
LAKE_COMPUTE_ORG=
LAKE_COMPUTE_DATABASE=
LAKE_COMPUTE_SCHEMA=

