# direnv entrypoint. Nothing secret belongs in this file — it is committed.
#
# Load order (last writer wins):
#   1. a private credential overlay outside the repo, via the source_dotfiles_env
#      helper if your ~/.config/direnv/direnvrc defines one. Without that helper
#      this step is a no-op and credentials come from .env instead.
#   2. .env — git-ignored, repo-local settings and the short-lived
#      HORIZON_ACCESS_TOKEN written by scripts/refresh_horizon_token.sh.
#      Loaded with dotenv_if_exists, not source_env_if_exists: the latter sources
#      the file as bash, so plain KEY=value lines would set shell variables that
#      never get exported.
#
# `dbt` itself comes from PATH (the published dbt Fusion CLI) — see README.
#
# Without direnv, `set -a && source .env && set +a` works; see .env.example.
if command -v source_dotfiles_env >/dev/null 2>&1; then
  source_dotfiles_env dbt-aws-cloud-cost
fi

dotenv_if_exists .env

# Derived — no need to repeat these in .env.
export DBT_PROFILES_DIR="${DBT_PROFILES_DIR:-$PWD}"
export DUCKDB_HOME="${DUCKDB_HOME:-$PWD/.tmp/duckdb-home}"
