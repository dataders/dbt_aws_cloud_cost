# direnv entrypoint. Nothing secret belongs in this file — it is committed.
#
# Load order (last writer wins):
#   1. .envrc.private  — git-ignored, optional; source your credential store from
#      here so catalog creds live outside the repo. One line is enough, e.g.:
#          source_env_if_exists "$HOME/my-private-env/dbt-aws-cloud-cost.envrc"
#   2. .env            — git-ignored, repo-local settings and the short-lived
#      HORIZON_ACCESS_TOKEN written by scripts/refresh_horizon_token.sh.
#      Overrides the private overlay.
#
# `dbt` itself comes from PATH (the published dbt Fusion CLI) — see README.
#
# Without direnv, `set -a && source .env && set +a` still works; you then export
# any catalog creds yourself.
source_env_if_exists .envrc.private
dotenv_if_exists .env

# Derived — no need to repeat these in .env.
export DBT_PROFILES_DIR="${DBT_PROFILES_DIR:-$PWD}"
export DUCKDB_HOME="${DUCKDB_HOME:-$PWD/.tmp/duckdb-home}"
